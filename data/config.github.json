{
  "ai": {
    "provider": "openai",
    "model": "moonshotai/kimi-k3.1-pro",
    "base_url": "https://api.numes.ai/api/v1",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "zh",
      "en"
    ],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 4.0,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 7.0,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [
      {
        "name": "Horizon",
        "repo": "Thysrael/Horizon",
        "enabled": true,
        "category": "AI"
      }
    ],
    "rss": [
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "AI",
        "profile": "tech"
      },
      {
        "name": "Anthropic News",
        "url": "https://www.anthropic.com/news/rss.xml",
        "enabled": true,
        "category": "AI",
        "profile": "tech"
      },
      {
        "name": "Google DeepMind Blog",
        "url": "https://deepmind.google/blog/rss.xml",
        "enabled": true,
        "category": "AI",
        "profile": "tech"
      },
      {
        "name": "MIT Technology Review - AI",
        "url": "https://www.technologyreview.com/topic/artificial-intelligence/feed/",
        "enabled": true,
        "category": "AI",
        "profile": "tech"
      },
      {
        "name": "Free LLM Intel - Model Changes",
        "url": "https://free-llm-intel.aishort.top/feeds/llm-intel-changes.xml",
        "enabled": true,
        "category": "AI",
        "profile": "tech"
      },
      {
        "name": "Free LLM Intel - LLM News",
        "url": "https://free-llm-intel.aishort.top/feeds/llm-news-all.xml",
        "enabled": true,
        "category": "AI",
        "profile": "tech"
      }
    ],
    "web": [
      {
        "name": "Hacker News",
        "url": "https://news.ycombinator.com/",
        "enabled": true,
        "category": "Tech",
        "profile": "tech-blog",
        "content_extractor": {
          "container_selector": "table.itemlist",
          "item_selector": "tr.athing",
          "title_selector": ".titleline > a",
          "link_selector": ".titleline > a",
          "score_selector": "span.score"
        }
      }
    ]
  },
  "scoring": {
    "weights": {
      "trend": 0.5,
      "impact": 0.4,
      "readability": 0.1
    },
    "quality_gate": {
      "min_total": 15.0
    }
  },
  "filters": {
    "min_content_chars": 80,
    "blocklist": [
      "广告",
      "推广",
      "sponsor"
    ],
    "require_keywords": []
  },
  "output": {
    "directory": "docs",
    "file_prefix": "daily",
    "filename_template": "daily-{date}.md",
    "date_format": "%Y-%m-%d",
    "timezone": "Asia/Shanghai",
    "use_utc": true,
    "include_raw": true,
    "include_json": true
  },
  "schedule": {
    "hours": 24,
    "window_start": "08:00",
    "window_end": "08:10"
  },
  "github": {
    "commit_enabled": false,
    "commit_message_template": "Daily update {date}",
    "branch": "main"
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s %(levelname)s %(name)s: %(message)s"
  },
  "llm_cache": {
    "cache_path": "data/cache/llm_cache.sqlite",
    "max_age_hours": 720
  }
}
